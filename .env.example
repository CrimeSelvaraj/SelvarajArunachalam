# Frontend (Next.js) — apps/web
# Origin of the FastAPI server used by next.config rewrites
API_ORIGIN=http://127.0.0.1:8000

# Backend (FastAPI) — apps/api
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- ATOZ sign-in, the $1 payment, and the takeover code ---
# Leave these blank to use the local sandbox stand-in. Do not put live secrets here.
# PayPal defaults to sandbox. Set PAYPAL_ENV=live only for a real charge.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Email for the six-digit code. Both are required to send mail.
# If both are blank, the code is written to the server log and shown on the new device.
RESEND_API_KEY=
EMAIL_FROM=

# SMS for the same code. All three are required to send a text.
# If they are blank, the phone field is saved and the screen says texting is not configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Required for later phases (not used by Phase 0–2 stubs) ---
# OPENAI_API_KEY=
# OPENALEX_API_KEY=
# GITHUB_TOKEN=
# CROSSREF_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# UNPAYWALL_EMAIL=
