# Frontend (Next.js) — apps/web
# Origin of the FastAPI server used by next.config rewrites
API_ORIGIN=http://127.0.0.1:8000

# Backend (FastAPI) — apps/api
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAlex (Phase 3 — discovery)
# Polite contact email for User-Agent / mailto query param (OpenAlex etiquette)
OPENALEX_MAILTO=you@example.com
# Optional free API key for higher daily budget: https://openalex.org/settings/api
# OPENALEX_API_KEY=

# GitHub (Phase 4 — discovery)
# Personal access token (classic or fine-grained) for higher REST search rate limits
# GITHUB_TOKEN=

# Screening (Phase 5 — optional LLM re-rank; heuristic used when unset)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# SCREENING_LLM_MODEL=gpt-4o-mini

# Evidence pack + PaperQA (Phase 6)
# OPENAI_API_KEY is also used by PaperQA (via LiteLLM). When unset, the pack still
# collects OA abstracts/PDFs/README text and marks PaperQA as skipped.
# Compatible alternatives PaperQA may pick up: ANTHROPIC_API_KEY, GEMINI_API_KEY, etc.
# PAPERQA_LLM=gpt-4o-2024-11-20
# PAPERQA_SUMMARY_LLM=gpt-4o-2024-11-20
# PAPERQA_EMBEDDING=text-embedding-3-small
# EVIDENCE_PACK_ROOT=./apps/api/data/evidence
# EVIDENCE_MAX_PDF_BYTES=12582912
# EVIDENCE_MAX_TEXT_CHARS=40000

# Article composer (Phase 7)
# Same OPENAI_API_KEY / OPENAI_BASE_URL as screening. When unset, a heuristic
# template article is built from evidence findings + quotes (still readable).
# COMPOSE_LLM_MODEL=gpt-4o-mini

# Citations & bibliography (Phase 8)
# citation_style on the job options defaults to "apa". Citekeys are BBT-inspired
# (auth+year+veryshorttitle). CSL-JSON is canonical; BibTeX via
# GET /jobs/{id}/bibliography.bib.

# Pandoc export (Phase 9)
# Install system pandoc (apt/brew) — required for HTML/DOCX; preferred for MD.
# Endpoints: GET /jobs/{id}/export.md|.html|.docx
# Do not vendor the pandoc Haskell sources. PDF needs TeX or typst (deferred).

# Optional enrichment keys (recommended before heavy PaperQA indexing)
# CROSSREF_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# UNPAYWALL_EMAIL=
