# Copy to apps/loop-read/.env.local — never commit real secrets.
# The app runs with none of these set. Missing email or PayPal settings
# turn on the documented demo paths (see README).

# --- Sign-in codes ---
# When ALL of SMTP_HOST, SMTP_USER, and SMTP_PASS are set, codes are emailed.
# Otherwise LOOP READ logs the code on the server and, in local development,
# shows it in a banner on the sign-in page.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="LOOP READ <read@example.com>"

# Show the demo code in the browser even when NODE_ENV=production.
# Local use only. Do not enable this on a public server.
# LOOP_READ_SHOW_DEMO_CODE=1

# --- PayPal access fee (1.00 USD) ---
# Create a REST app at https://developer.paypal.com/dashboard/applications
# Sandbox credentials charge the PayPal sandbox, not real buyers.
# When CLIENT_ID or CLIENT_SECRET is missing, the Access page offers a
# demo unlock instead of a live charge.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# Set to 1 only if the site is served over HTTPS.
# LOOP_READ_COOKIE_SECURE=1
